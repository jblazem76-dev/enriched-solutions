{
  "name": "es-api",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Enriched Solutions API on Azure Functions. Receives form leads from ES projects and delivers them through Resend.",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prestart": "npm run build",
    "start": "func start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
