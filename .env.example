# Where the site's forms go. Set up ONE of the two options below.
# With neither, POST /api/lead answers 503 and the forms tell visitors to email instead. It never pretends
# a sign-up or booking request was saved.

# --- Option 1 (recommended): Resend API -------------------------------------------------------------
# Create a key at https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=
# Where notification emails arrive: every EKG booking request, and every ES+ / Golf & Heels sign-up.
# Until a domain is verified in Resend, this must be the email address of the Resend account owner.
LEAD_NOTIFY_EMAIL=
# Optional. Sender address. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the account owner. After verifying enrichedsolutions.net in Resend, use e.g.
# "Enriched Solutions <hello@enrichedsolutions.net>".
LEAD_FROM_EMAIL=
# Optional. Sign-ups (not booking requests) are also saved as contacts in this Resend segment.
RESEND_SEGMENT_ID=

# --- Option 2: any endpoint that accepts a JSON POST (Zapier, Make, your own API) ------------------
# Used only when RESEND_API_KEY is empty.
# Payload: { "source": "ekg-booking" | "es-plus" | "golf-and-heels" | "newsletter", "name", "email",
#            "organization", "format", "eventDate", "message", "submittedAt", "site" }
LEAD_WEBHOOK_URL=
