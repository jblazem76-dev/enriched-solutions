# Where sign-ups from the EKG, ES+ and Golf & Heels forms are sent.
# Any endpoint that accepts a JSON POST works (Zapier, Make, a Resend/Mailchimp automation, your own API).
# Payload: { "name": string, "email": string, "source": "ekg" | "es-plus" | "golf-and-heels" | "newsletter",
#            "submittedAt": ISO-8601 string, "site": "enrichedsolutions.net" }
#
# If this is empty, POST /api/lead answers 503 and the forms tell visitors to email instead.
# It never pretends a sign-up was saved.
LEAD_WEBHOOK_URL=
